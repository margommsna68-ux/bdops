# Database
DATABASE_URL="postgresql://bdops:password@localhost:5432/bdops"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Encryption (32 bytes hex for AES-256)
ENCRYPTION_KEY="your-64-char-hex-string-here-generate-with-openssl-rand-hex-32"
# Full application database backup: system owner only; never project-wide.
SYSTEM_OWNER_USER_ID=
BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
PG_DUMP_PATH=
PG_RESTORE_PATH=
