// ═══════════════════════════════════════
// ACCOUNT INVENTORY (17 Oct 2026): Gmail / Apple ID login stock, PayPal stock, purchase batches, EarnApp links
// ═══════════════════════════════════════
enum AccountLoginType {
  GMAIL
  APPLE_ID
}

// One receiving batch (lô nhập). The actual paid amount is recorded once in the cost ledger (costRecordId); the per-account price
// shown in the stock is only an allocation of that payment and never counts again in profit.
model AccountPurchaseBatch {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind         String // LOGIN | PAYPAL
  loginType    AccountLoginType?
  code         String
  source       String?
  purchasedAt  DateTime
  priceMode    String            @default("NONE") // NONE | UNIT | TOTAL
  unitPrice    Decimal?          @db.Decimal(24, 8)
  totalPaid    Decimal?          @db.Decimal(24, 8)
  currency     String?
  lineCount    Int               @default(0) // lines pasted in the first import (information only; never the paid quantity)
  paidQuantity Int? // quantity actually bought, entered with a unit price (unit × quantity = paid total)
  costRule     Int               @default(2) // 1 = created before 17/10 fix (unit × pasted lines, same code appended): listed for review
  costRecordId String?           @unique
  costRecord   CostRecord?       @relation(fields: [costRecordId], references: [id], onDelete: Restrict)
  notes        String?
  createdById  String
  revision     Int               @default(0)
  archivedAt   DateTime?
  logins       GmailAccount[]
  paypals      PayPalAccount[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([projectId, kind, code])
}

// The EarnApp account: registered with one login (Gmail or Apple ID), runs on at most one VM and pays out to one PayPal.
// Assignment is not registration: registeredAt is only set by an explicit operator record.
model EarnAppAccount {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  loginId        String             @unique
  login          GmailAccount       @relation(fields: [loginId], references: [id], onDelete: Restrict)
  vmId           String?            @unique
  vm             VirtualMachine?    @relation(fields: [vmId], references: [id], onDelete: Restrict)
  // Receiving email of this EarnApp account (one email, one EarnApp). paypalId is that email's PayPal, kept for reads and old links
  // whose email is not known yet (several EarnApp accounts may share a PayPal through different emails).
  paypalId       String?
  paypal         PayPalAccount?     @relation(fields: [paypalId], references: [id], onDelete: Restrict)
  paypalEmailId  String?            @unique
  paypalEmail    PayPalEmail?       @relation(fields: [paypalEmailId], references: [id], onDelete: Restrict)
  payouts        EarnAppPayout[]
  payoutRequest  EarnPayoutRequest?
  linkedSdks     SdkRecord[]
  // Closed when its VM was recreated (or the account was suspended for good): never assigned again, never back to NEW.
  closedAt       DateTime?
  closedReason   String?
  registeredAt   DateTime?
  registeredById String?
  revision       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([projectId])
  @@index([paypalId])
}

// History of the receiving email of an EarnApp account: one row per period (endedAt null = current). Old payments keep their own
// email / EarnApp / VM snapshot on FundTransaction; this table answers which email an account used when.
model EarnAppPayout {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  earnAppId     String
  earnApp       EarnAppAccount @relation(fields: [earnAppId], references: [id], onDelete: Restrict)
  paypalId      String?
  paypal        PayPalAccount? @relation(fields: [paypalId], references: [id], onDelete: Restrict)
  paypalEmailId String?
  paypalEmail   PayPalEmail?   @relation(fields: [paypalEmailId], references: [id], onDelete: Restrict)
  vmId          String?
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  createdById   String?

  @@index([projectId, earnAppId])
  @@index([paypalEmailId])
}

// ═══════════════════════════════════════
// VM OPERATION CYCLE (owner brief 18/10/2026)
// ═══════════════════════════════════════
// Main operating state of a VM position as recorded by a person / AI. Never inferred from SDK, account or proxy data; no row or a
// null status = "Chưa ghi". cycle = the current install / operating round of this VM position (1 until it is recreated).
enum VmOpsStatus {
  OK
  NOT_LINKED
  OFF
  PROXY_BLOCKED
  LINKED
  EARN_ERROR
  SUSPENDED
  DELETED
  NEW_VM
  MAIL_LOGGED
  PROXY_PENDING
}

model VmOperation {
  id                   String         @id @default(cuid())
  projectId            String
  vmId                 String         @unique
  vm                   VirtualMachine @relation(fields: [vmId], references: [id], onDelete: Restrict)
  cycle                Int            @default(1)
  status               VmOpsStatus?
  statusAt             DateTime?
  statusById           String?
  // Status before "Blocked" (owner decision 19/10/2026): which proxy caused it, in which round, and the status to bring back when
  // that proxy is replaced. blockedFromKnown=false: the earlier status could not be found in this round's history (restore = Chưa ghi).
  blockedFrom          VmOpsStatus?
  blockedFromKnown     Boolean        @default(false)
  blockedEndpointId    String?
  blockedCycle         Int?
  blockedAt            DateTime?
  // Proxy on the real machine (owner brief 21/10/2026): the configuration the machine still has to apply after a proxy change on the web,
  // and the last one confirmed applied. Not part of the status revision.
  proxyPendingConfigId String?
  proxyPendingAt       DateTime?
  proxyAppliedConfigId String?
  proxyAppliedAt       DateTime?
  proxyAppliedById     String?
  revision             Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([projectId])
}

// One active piece of work on a VM by a person / AI (owner brief 21/10/2026): who took it, until when, the step reached, the machine
// it made and the SDK / proxy configuration of this attempt. At most one ACTIVE, unexpired job per VM (checked under the VmOperation row
// lock). Not a schedule: a job exists only because someone took the VM in hand.
model VmJob {
  id              String    @id @default(cuid())
  projectId       String
  vmId            String
  cycle           Int
  kind            String // PREPARE | PROXY_APPLY | CHECK
  state           String    @default("ACTIVE") // ACTIVE | DONE | RELEASED
  claimedById     String
  tokenId         String?
  claimedAt       DateTime  @default(now())
  expiresAt       DateTime
  step            String?
  stepNote        String?
  stepAt          DateTime?
  machineRef      String?
  configurationId String?
  sdkId           String?
  resumeOf        String?
  // VmOperation.revision when the job was taken: a status changed by someone else meanwhile is never overwritten by the job's result.
  statusRevision  Int       @default(0)
  result          String?
  finishedAt      DateTime?
  revision        Int       @default(0)

  @@index([vmId, state])
  @@index([projectId, state])
}

// What happened to a VM position: status changes (old → new), recreations, undo. Append-only.
model VmOpsEvent {
  id         String       @id @default(cuid())
  projectId  String
  vmId       String
  cycle      Int
  kind       String // STATUS | RECREATE | UNDO
  fromStatus VmOpsStatus?
  toStatus   VmOpsStatus?
  note       String?
  detail     Json?
  actorId    String
  createdAt  DateTime     @default(now())

  @@index([vmId, createdAt])
  @@index([projectId, createdAt])
}

// A closed round of a VM position, written when the VM is recorded as recreated. One closing per (VM, round) and per payout request.
model VmCycle {
  id                       String       @id @default(cuid())
  projectId                String
  vmId                     String
  number                   Int
  reason                   String // PAYOUT_RECEIVED | SUSPENDED
  earnAppId                String?
  loginId                  String?
  paypalEmailId            String?
  sdkId                    String?
  status                   VmOpsStatus?
  desiredConfigurationId   String?
  installedConfigurationId String?
  proxyKept                String? // endpoint kept for the next round (needs a new install confirmation)
  payoutRequestId          String?      @unique
  note                     String?
  closedById               String
  closedAt                 DateTime     @default(now())

  @@unique([vmId, number])
  @@index([projectId])
}

// The one payout request of an EarnApp account (owner decision 18/10/2026: one EarnApp, one withdrawal). Retries, lost answers and
// status corrections stay on this row. Money received is the confirmed FundTransaction rows linked to it (the PayPal book); this
// row only says what was asked for. state is the person's record: REQUESTED, FAILED or CANCELLED (with a note).
model EarnPayoutRequest {
  id            String            @id @default(cuid())
  projectId     String
  earnAppId     String            @unique
  earnApp       EarnAppAccount    @relation(fields: [earnAppId], references: [id], onDelete: Restrict)
  vmId          String
  cycle         Int
  paypalId      String
  paypal        PayPalAccount     @relation(fields: [paypalId], references: [id], onDelete: Restrict)
  paypalEmailId String
  paypalEmail   PayPalEmail       @relation(fields: [paypalEmailId], references: [id], onDelete: Restrict)
  currency      String            @default("USD")
  amount        Decimal           @db.Decimal(12, 2)
  reference     String?
  requestedAt   DateTime
  requestedById String
  state         String            @default("REQUESTED")
  stateNote     String?
  // Received less than asked and a person stated why (fee / shortfall): settled with that gap, never assumed.
  settledAt     DateTime?
  settledById   String?
  settleNote    String?
  shortfall     Decimal?          @db.Decimal(12, 2)
  // Set when this money was used to record the VM as recreated (one recreation per request).
  consumedAt    DateTime?
  history       Json              @default("[]")
  // Submission on EarnApp (owner brief 20/10/2026): SENT = sent and waiting for PayPal (all requests before this date);
  // PREPARING = email held, not sent yet; UNKNOWN = the click was made but the result is not known (check EarnApp's history first).
  submission    String            @default("SENT")
  submittedAt   DateTime?
  revision      Int               @default(0)
  receipts      FundTransaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId, paypalId])
  @@index([vmId])
}

// ═══════════════════════════════════════
// SDK STORE (owner brief 19/10/2026)
// ═══════════════════════════════════════
// An EarnApp SDK code as its own record, shared by every server of a project. vmId = its one current VM position (null = in the
// store); VirtualMachine.sdkId is only a mirror written by the same code (src/server/vm-management/sdk-store.ts).
// linkState: UNLINKED = never linked to an EarnApp account as far as the web knows (may be reused or moved); LINKED = recorded as
// linked (account, time, person): never offered for reuse again, whatever happens to the VM / account / undo; UNCONFIRMED = old
// data without that evidence (migration): shown as "Chưa xác nhận", never offered until a person confirms it.
// amount = the latest accumulated money recorded by an operator (not a price, never income / cost); null = not recorded, 0 = zero.
enum SdkLinkState {
  UNLINKED
  LINKED
  UNCONFIRMED
}

model SdkRecord {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  code            String
  vmId            String?         @unique
  vm              VirtualMachine? @relation("SdkPlacement", fields: [vmId], references: [id], onDelete: Restrict)
  // The VM whose SDK list holds the code (owner brief 20/10/2026: one VM keeps many SDKs, to use now or later). Not unique. vmId
  // (above) stays the one "current" code of the machine; when vmId is set, holderVmId is the same VM.
  holderVmId      String?
  holder          VirtualMachine? @relation("SdkHolding", fields: [holderVmId], references: [id], onDelete: Restrict)
  heldAt          DateTime?
  heldById        String?
  placedAt        DateTime?
  placedById      String?
  amount          Decimal?        @db.Decimal(18, 6)
  currency        String          @default("USD")
  amountAt        DateTime?
  amountById      String?
  // 22/10/2026 (AI SDK money): when the amount was seen on the machine (amountAt = when it was written) and where it was read. An
  // observation older than the stored one never replaces it. null on old rows: amountAt stands for both.
  amountObservedAt DateTime?
  amountSource     String?
  // Tiền VM (22/10/2026): the latest reading that could not read the money (the last good figure keeps its own time; never 0).
  amountFailedAt   DateTime?
  // Independent review 22/10/2026: on which VM and in which round the figure / the failed reading was checked. The row shows a
  // figure only for that VM + round; elsewhere it is history ("Chưa kiểm tra" until checked again). Old rows: backfilled to the
  // current VM + round of the code (identity only).
  amountVmId       String?
  amountCycle      Int?
  amountFailedVmId String?
  amountFailedCycle Int?
  note            String?
  noteAt          DateTime?
  noteById        String?
  linkState       SdkLinkState    @default(UNLINKED)
  linkedEarnAppId String?
  linkedEarnApp   EarnAppAccount? @relation(fields: [linkedEarnAppId], references: [id], onDelete: Restrict)
  linkedVmId      String?
  linkedCycle     Int?
  linkedAt        DateTime?
  linkedById      String?
  confirmedAt     DateTime?
  confirmedById   String?
  revision        Int             @default(0)
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          SdkEvent[]

  @@unique([projectId, code])
  @@index([projectId, linkState])
  @@index([holderVmId])
}

// What happened to an SDK code (append-only): recorded, placed / moved / removed with the VM positions as text, money / note old →
// new, linked, confirmed, undone, migrated.
model SdkEvent {
  id        String    @id @default(cuid())
  projectId String
  sdkId     String
  sdk       SdkRecord @relation(fields: [sdkId], references: [id], onDelete: Cascade)
  kind      String // CREATE | PLACE | MOVE | REMOVE | AMOUNT | NOTE | LINK | CONFIRM | RECREATE | UNDO | MIGRATE
  fromVmId  String?
  toVmId    String?
  fromLabel String?
  toLabel   String?
  detail    Json?
  actorId   String
  createdAt DateTime  @default(now())

  @@index([sdkId, createdAt])
  @@index([projectId, createdAt])
}

// EarnApp balance checks (owner brief 20/10/2026): what a person / AI read on the EarnApp account of a VM, at the time it was read.
// History only (never edited); the current figure is the newest check (by checkedAt) of the VM's current EarnApp in its current
// round, so an older check arriving late never replaces a newer one. A failed check keeps the last good figure. Never income or cost.
model EarnBalanceCheck {
  id           String   @id @default(cuid())
  projectId    String
  vmId         String
  cycle        Int
  earnAppId    String
  checkedAt    DateTime
  outcome      String // OK | FAILED
  amount       Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")
  // Withdrawal condition as observed on EarnApp: YES (the app offers the payout), NO, UNKNOWN (only the balance was read).
  withdrawable String   @default("UNKNOWN")
  condition    String?
  failure      String?
  evidence     String? // a reference (file name, note); never a password, 2FA link or code
  source       String // CELL | PASTE | AI | OTHER
  recordedById String
  recordedAt   DateTime @default(now())

  @@index([projectId, vmId, checkedAt])
  @@index([earnAppId, checkedAt])
}

// ─── API vận hành AI (/api/ops/v1, owner brief 21/10/2026) ───────────────────────────────────────────────────────────────────
// A token belongs to one user and acts within that user's CURRENT rights (re-read on every request), limited to its projects and
// operations. Only the SHA-256 of the token is stored; the full token is shown once at creation.
model OpsToken {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  tokenHash   String    @unique
  userId      String
  projectIds  String[]
  scopes      String[]
  allowedIps  String[]  @default([])
  expiresAt   DateTime
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  // The request that created it (owner brief 22/10/2026): a retried / double-clicked create never makes a second token.
  createKey   String?   @unique

  @@index([userId])
}

// Fixed-window counters shared by every instance (rate limits, failed PINs per token).
model OpsRateBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

// Bind a batch key to the exact request even if none of its items need approval.
// No payload, result or credential is stored here; individual commands own replay.
model OpsBatchKey {
  key         String   @id
  tokenId     String
  projectId   String
  payloadHash String
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// Audit of every API call that reached a decision (allowed fields only: never headers, body, PIN or token).
model OpsAudit {
  id         String   @id @default(cuid())
  requestId  String
  tokenId    String?
  userId     String?
  projectId  String?
  action     String
  objectId   String?
  ip         String?
  httpStatus Int
  result     String
  replay     Boolean  @default(false)
  at         DateTime @default(now())

  @@index([tokenId, at])
  @@index([projectId, at])
}

// A signed-in web session (owner brief 22/10/2026). The JWT carries only its id; every request checks it is not revoked, belongs to the
// user, matches the user's authEpoch and that the user is enabled. The PIN unlock belongs to this session and to the PIN version it
// was made with: a PIN change, sign-out or disabling the user ends it.
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  epoch         Int
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokeReason  String?
  pinUnlockedAt DateTime?
  pinVersion    Int?
  // TOTP unlock of this session (23/10/2026): proved with the user's TOTP version; totpAtLogin = the code was given at sign-in.
  totpUnlockedAt DateTime?
  totpVersion    Int?
  totpAtLogin    Boolean   @default(false)

  @@index([userId, revokedAt])
}

// One-time backup codes of a user's 2FA (23/10/2026): bcrypt hashes, each usable once.
model UserBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A critical ops-API command waiting for an ADMIN's 2FA approval (owner decision 23/10/2026): the AI's request is held with the hash of
// exactly what it sent; the ADMIN sees the allowed summary and approves with a TOTP code; the AI's retry with the same key then runs once.
model OpsApproval {
  id                String    @id @default(cuid())
  projectId         String
  tokenId           String
  userId            String
  action            String
  method            String
  path              String
  objectId          String?
  requestKey        String
  payloadHash       String
  summary           Json
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now())
  expiresAt         DateTime
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  consumedAt        DateTime?
  consumedRequestId String?
  // CLI confirmation with the ADMIN's TOTP (23/10/2026 evening): wrong codes per approval; 5 → LOCKED (ask again with a new key).
  confirmFailed     Int       @default(0)

  @@index([projectId, status, requestedAt])
  @@index([requestKey, status])
}
