  exchangeEmail String?
  notes         String?
  agentUser     User             @relation("AgentSales", fields: [agentUserId], references: [id])
  agentUserId   String
  agentEmail    AgentPaypalEmail @relation("AgentSaleEmail", fields: [agentEmailId], references: [id])
  agentEmailId  String
  project       Project          @relation(fields: [projectId], references: [id])
  projectId     String
  date          DateTime         @default(now())
  createdAt     DateTime         @default(now())
