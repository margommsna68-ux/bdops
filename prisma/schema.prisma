generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// AUTH & MULTI-PROJECT
// ═══════════════════════════════════════

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String?         @unique
  name          String?
  password      String?
  pin           String?
  lastActiveAt  DateTime?
  image         String?
  // Brute-force protection — lock requires admin unlock
  loginFailedCount Int          @default(0)
  loginLockedAt    DateTime?
  pinFailedCount   Int          @default(0)
  pinLockedAt      DateTime?
  memberships   ProjectMember[]
  auditLogs     AuditLog[]
  proxyAssignments ProxyAssignmentHistory[] @relation("AssignedByUser")
  assignedTasks VMTask[]        @relation("TaskAssignee")
  businessWorkItems BusinessWorkItem[] @relation("BusinessAssignee")
  deleteRequestsMade    DeleteRequest[] @relation("DeleteRequestor")
  deleteRequestsReviewed DeleteRequest[] @relation("DeleteReviewer")
  agentEmails      AgentPaypalEmail[] @relation("AgentEmails")
  agentWithdrawals Withdrawal[]    @relation("AgentWithdrawals")
  agentSales       AgentSale[]     @relation("AgentSales")
  resolvedDisputes Withdrawal[]    @relation("DisputeResolver")
  collectorExpenses CollectorExpense[] @relation("CollectorExpenses")
  teamCollectedReceipts TeamReceipt[] @relation("TeamReceiptCollector")
  teamCreatedReceipts TeamReceipt[] @relation("TeamReceiptCreator")
  editHistory   EditHistory[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum ProjectType {
  FULL
  PAYPAL_ONLY
}

model Project {
  id               String          @id @default(cuid())
  name             String
  code             String          @unique
  type             ProjectType     @default(FULL)
  description      String?
  settings         Json?
  members          ProjectMember[]
  proxyCatalog     ProxyProviderAccount[]
  proxySnapshots   ProxySourceSnapshot[]
  proxyEvents      ProxyStatusEvent[]
  proxyBatches     ProxyBatch[]
  proxyReplacements ProxyReplacement[]
  servers          Server[]
  paypalAccounts   PayPalAccount[]
  paypalEmails     PayPalEmail[]
  fundTransactions FundTransaction[]
  withdrawals      Withdrawal[]
  costRecords      CostRecord[]
  teamReceipts     TeamReceipt[]
  profitSplits     ProfitSplit[]
  partners         Partner[]
  proxyIPs         ProxyIP[]
  proxyGroups      ProxyGroup[]
  gmailAccounts    GmailAccount[]
  deleteRequests   DeleteRequest[]
  agentPaypalEmails AgentPaypalEmail[]
  agentSales       AgentSale[]
  collectorExpenses CollectorExpense[]
  holderMergeTargets HolderMergeTarget[]
  earnWithdrawals  EarnWithdrawal[]
  editHistory      EditHistory[]
  operationJournal OperationJournal[]
  vmConfigurations VMConfiguration[]
  vmAllocations VMProxyAllocation[]
  vmSdkHistory VMSdkHistory[]
  businessWorkItems BusinessWorkItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ProjectMember {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  project         Project     @relation(fields: [projectId], references: [id])
  projectId       String
  role            ProjectRole @default(USER)
  allowedModules  String[]    @default([])
  capabilities    String[]    @default([])
  accessRevision  Int         @default(0)
  canManageUsers  Boolean     @default(false)
  managerId       String?
  maxAutotypeDevices Int      @default(2)
  agentFeePercent Decimal?    @db.Decimal(5, 2) // % agent nhận (default 3%)
  manager         ProjectMember?  @relation("TeamMembers", fields: [managerId], references: [id])
  teamMembers     ProjectMember[] @relation("TeamMembers")
  createdAt       DateTime    @default(now())

  @@unique([userId, projectId])
}

enum ProjectRole {
  ADMIN
  MODERATOR
  USER
  VIEWER
}

// ═══════════════════════════════════════
// INFRASTRUCTURE
// ═══════════════════════════════════════

model Server {
  id            String       @id @default(cuid())
  code          String
  ipAddress     String?
  netmask       String?
  gateway       String?
  allocation    String?
  provider      String?
  cpu           String?
  ram           String?
  status        ServerStatus @default(BUILDING)
  credentials   Json?
  inventoryId   String?
  notes         String?
  managed       Boolean @default(false)
  archivedAt    DateTime?
  revision      Int @default(0)
  gmailGroup    Int          @default(1)
  monthlyCost   Decimal?     @db.Decimal(12, 2)
  billingCycle  Int?         @default(1) // months
  createdDate   DateTime?
  expiryDate    DateTime?
  project       Project      @relation(fields: [projectId], references: [id])
  projectId     String
  vms           VirtualMachine[]
  fundTransactions FundTransaction[]
  earnWithdrawals EarnWithdrawal[]
  businessWorkItems BusinessWorkItem[]
  costRecords CostRecord[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([code, projectId])
  @@index([projectId])
}

enum ServerStatus {
  BUILDING
  ACTIVE
  SUSPENDED
  EXPIRED
  MAINTENANCE
}

model VirtualMachine {
  businessWorkItems BusinessWorkItem[]
  id            String      @id @default(cuid())
  code          String
  status        VMStatus    @default(NEW)
  sdkId         String?
  sdkRecordedAt DateTime?
  sdkRecordedById String?
  sdkHistory    VMSdkHistory[]
  earnTotal     Decimal?    @db.Decimal(12, 4)
  earn24h       Decimal?    @db.Decimal(12, 4)
  uptime        String?
  notes         String?
  managed       Boolean @default(false)
  proxySlotState VMProxySlotState @default(UNRESOLVED)
  slotSourceRef String?
  originalSlotCipher String?
  revision Int @default(0)
  configurationSequence Int @default(0)
  archivedAt DateTime?
  desiredConfigurationId String? @unique
  desiredConfiguration VMConfiguration? @relation("DesiredVMConfiguration",fields:[desiredConfigurationId],references:[id],onDelete:Restrict)
  installedConfigurationId String? @unique
  installedConfiguration VMConfiguration? @relation("InstalledVMConfiguration",fields:[installedConfigurationId],references:[id],onDelete:Restrict)
  configurations VMConfiguration[] @relation("VMVersions")
  allocations VMProxyAllocation[]
  server        Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  proxy         ProxyIP?    @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  proxyId       String?     @unique
  gmail         GmailAccount? @relation(fields: [gmailId], references: [id], onDelete: SetNull)
  gmailId       String?
  proxyHistory  ProxyAssignmentHistory[]
  tasks         VMTask[]
  fundTransactions FundTransaction[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([code, serverId])
}

enum VMStatus {
  NEW
  OK
  ERROR
  SUSPENDED
  NOT_CONNECTED
  NOT_AVC
  BLOCKED
}

// ═══════════════════════════════════════
// EARN APP WITHDRAWAL TRACKING
// ═══════════════════════════════════════

enum EarnWithdrawalStatus {
  PENDING
  WITHDRAWAL
  PAID
  SUSPEND
  PP_LIMIT
}

model EarnWithdrawal {
  id        String               @id @default(cuid())
  vmCodes   String               // e.g. "001-002" or "001"
  amount    Decimal?             @db.Decimal(12, 2)
  date      DateTime?
  time      String?              // "HH:MM" format
  status    EarnWithdrawalStatus @default(PENDING)
  notes     String?
  round     Int                  @default(1)
  gmail     GmailAccount         @relation(fields: [gmailId], references: [id], onDelete: Cascade)
  gmailId   String
  paypal    PayPalAccount?       @relation("EarnWithdrawalPaypal", fields: [paypalId], references: [id], onDelete: SetNull)
  paypalId  String?
  server    Server               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  project   Project              @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([projectId, serverId])
  @@index([gmailId])
}

model ProxyIP {
  id            String      @id @default(cuid())
  address       String
  host          String?
  port          Int?
  subnet        String?
  status        ProxyStatus @default(AVAILABLE)
  outboundIP    String?
  blockReason   String?
  identityId    String?
  identity      ProxyIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  credentialCipher String?
  packageCode   String?
  groupId       String?
  group         ProxyGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  inventoryState ProxyInventoryState @default(QUARANTINED)
  inventoryKey  String?
  revision      Int @default(0)
  statusAt      DateTime?
  retiredAt     DateTime?
  notesCipher   String?
  hasManualMetadata Boolean @default(false)
  sourceRefs    ProxySourceReference[]
  vmConfigurations VMConfiguration[]
  allocations VMProxyAllocation[]
  statusEvents  ProxyStatusEvent[]
  replacedFrom  ProxyReplacement[] @relation("ReplacementOld")
  replacedTo    ProxyReplacement[] @relation("ReplacementNew")
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  vm            VirtualMachine?
  assignmentHistory ProxyAssignmentHistory[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([address, projectId])
  @@index([projectId, status])
  @@index([identityId])
  @@index([projectId, inventoryState])
  @@index([projectId, groupId])
}

enum ProxyOwner {
  SELF
  GENJY
  UNKNOWN
  OTHER
}
enum ProxySubgroup {
  PC_CHUNG
}
enum ProxyAllocationMode {
  SINGLE_IP
  APPROVED_PORT_STREAM
}
enum ProxyInventoryState {
  NEW
  LIVE
  BLOCKED
  REPLACED
  DIE
  QUARANTINED
  VOID
  RETIRED
}
model ProxyIdentity {
  id String @id @default(cuid())
  ip String @unique @db.Inet
  owner ProxyOwner @default(UNKNOWN)
  subgroup ProxySubgroup?
  allocationMode ProxyAllocationMode @default(SINGLE_IP)
  ownerDecidedAt DateTime?
  ownerDecidedBy String?
  policyEvidenceCipher String?
  revision Int @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  endpoints ProxyIP[]
  sourceRefs ProxySourceReference[]
  events ProxyStatusEvent[]
}
// Operator-defined proxy group ("Từ nhóm"). TUT (owner SELF) and genjy are not rows here; a group row always means owner OTHER.
model ProxyGroup {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  name String
  normalizedName String
  createdById String?
  archivedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  endpoints ProxyIP[]
  @@unique([projectId,normalizedName])
}

model ProxyProviderAccount {
  costRecords CostRecord[]
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  code String
  label String
  credentialCipher String
  disabled Boolean @default(false)
  site String?
  note String?
  price Decimal? @db.Decimal(24,8)
  priceCurrency String?
  cycleMonths Int @default(1)
  nextDueDate DateTime? @db.Date
  lastPaidAt DateTime?
  reminderDays Int @default(7)
  renewalStoppedAt DateTime?
  renewalStopNote String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([projectId,code])
  @@index([projectId,nextDueDate])
}
model ProxySourceSnapshot {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  sourceKey String
  hash String
  fetchedAt DateTime @default(now())
  scanSucceeded Boolean
  metadata Json?
  encryptedPayload String?
  references ProxySourceReference[]
  @@index([projectId,sourceKey,fetchedAt])
}
model ProxySourceReference {
  id String @id @default(cuid())
  snapshotId String
  snapshot ProxySourceSnapshot @relation(fields:[snapshotId], references:[id], onDelete:Restrict)
  identityId String
  identity ProxyIdentity @relation(fields:[identityId], references:[id], onDelete:Restrict)
  endpointId String?
  endpoint ProxyIP? @relation(fields:[endpointId], references:[id], onDelete:Restrict)
  sourceRef String
  format String
  owner ProxyOwner
  subgroup ProxySubgroup?
  hasFullCredentials Boolean @default(false)
  hasManualMetadata Boolean @default(false)
  dataCipher String?
  @@index([identityId,snapshotId])
  @@unique([snapshotId,sourceRef,identityId])
}
model ProxyBatch {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  actorId String
  kind String
  idempotencyKey String
  payloadHash String
  token String @unique
  encryptedPlan String
  sourceHash String
  revisionFacts Json
  previewRows Json
  result Json?
  status String @default("PREVIEW")
  expiresAt DateTime
  createdAt DateTime @default(now())
  appliedAt DateTime?
  events ProxyStatusEvent[]
  replacements ProxyReplacement[]
  @@unique([projectId,idempotencyKey])
  @@index([projectId,createdAt])
}
model ProxyStatusEvent {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  identityId String
  identity ProxyIdentity @relation(fields:[identityId], references:[id], onDelete:Restrict)
  endpointId String?
  endpoint ProxyIP? @relation(fields:[endpointId], references:[id], onDelete:Restrict)
  batchId String?
  batch ProxyBatch? @relation(fields:[batchId], references:[id], onDelete:Restrict)
  ip String @db.Inet
  kind String
  occurredAt DateTime?
  recordedAt DateTime @default(now())
  reversedAt DateTime?
  actorId String?
  reason String?
  sourceRef String?
  @@index([projectId,identityId,recordedAt])
}

model OperationJournal {
  accessModule String @default("INFRASTRUCTURE")
  commandKey String?
  requestHash String?
  resultCipher String?
  @@unique([projectId,commandKey])
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  actorId String
  kind String
  summary Json
  snapshotCipher String
  reversible Boolean @default(true)
  batchId String? @unique
  undoOfId String? @unique
  createdAt DateTime @default(now())
  @@index([projectId,createdAt])
}
model ProxyReplacement {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  oldEndpointId String
  oldEndpoint ProxyIP @relation("ReplacementOld",fields:[oldEndpointId], references:[id], onDelete:Restrict)
  newEndpointId String @unique
  newEndpoint ProxyIP @relation("ReplacementNew",fields:[newEndpointId], references:[id], onDelete:Restrict)
  ownerSnapshot ProxyOwner
  subgroupSnapshot ProxySubgroup?
  receivedDate DateTime? @db.Date
  recordedAt DateTime @default(now())
  actorId String
  status String @default("APPLIED")
  batchId String
  batch ProxyBatch @relation(fields:[batchId], references:[id], onDelete:Restrict)
  @@index([projectId,oldEndpointId])
}

enum ProxyStatus {
  AVAILABLE
  IN_USE
  BLOCKED
  RESERVED
}

model ProxyAssignmentHistory {
  id            String          @id @default(cuid())
  proxy         ProxyIP         @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  proxyId       String
  vm            VirtualMachine  @relation(fields: [vmId], references: [id], onDelete: Cascade)
  vmId          String
  assignedAt    DateTime        @default(now())
  unassignedAt  DateTime?
  reason        String?
  assignedBy    User?           @relation("AssignedByUser", fields: [assignedById], references: [id])
  assignedById  String?
  createdAt     DateTime        @default(now())
}

// ═══════════════════════════════════════
// ACCOUNT MANAGEMENT
// ═══════════════════════════════════════

model GmailAccount {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  archivedAt DateTime?
  id            String      @id @default(cuid())
  email         String      @unique
  password      String?
  twoFaCurrent  String?
  twoFaOld      String?
  recoveryEmail String?
  token         String?
  status        GmailStatus @default(ACTIVE)
  notes         String?
  vms           VirtualMachine[]
  paypal        PayPalAccount? @relation(fields: [paypalId], references: [id], onDelete: SetNull)
  paypalId      String?
  earnWithdrawals EarnWithdrawal[]
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([projectId])
}

enum GmailStatus {
  ACTIVE
  SUSPENDED
  NEEDS_RECOVERY
  NEEDS_2FA_UPDATE
  BLOCKED
  DISABLED
}

model PayPalAccount {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  archivedAt DateTime?
  id              String       @id @default(cuid())
  code            String
  primaryEmail    String       // denormalized from PayPalEmail for quick display/search
  secondaryEmail  String?
  password        String?      // encrypted (legacy, credentials now in PayPalEmail)
  twoFa           String?      // encrypted (legacy)
  bankCode        String?
  hotmailToken    String?      // encrypted (legacy)
  holder          String?      // who manages this PP
  vmppCode        String?      // VMPP code for PP management
  status          PayPalStatus @default(ACTIVE)
  role            PayPalRole   @default(NORMAL)
  limitNote       String?
  company         String       @default("Bright Data Ltd.")
  serverAssignment String?
  notes           String?
  holderName      String?      // Tên chủ PP
  dateOfBirth     String?      // Ngày sinh
  idNumber        String?      // Số CCCD
  address         String?      // Địa chỉ
  phone           String?      // SĐT
  docsLink        String?      // Link docs (Google Drive, etc.)
  suspendedAt     DateTime?    // Ngày bị suspend vĩnh viễn
  limitedAt       DateTime?    // Ngày bị limit (cần updocs)
  workflowStatus  String?      // updocs | appeal | resolved
  caseHistory     Json?        // [{date, type, note, docsLink}] - lịch sử xử lý
  tokenHealthStatus    String?  // HEALTHY | INVALID | ERROR | MISSING
  tokenHealthCheckedAt DateTime?
  tokenHealthError     String?
  project         Project      @relation(fields: [projectId], references: [id])
  projectId       String
  emails          PayPalEmail[]
  gmails          GmailAccount[]
  fundsReceived   FundTransaction[]
  withdrawalsFrom Withdrawal[] @relation("WithdrawalSource")
  withdrawalsTo   Withdrawal[] @relation("WithdrawalDest")
  mergeTargets    HolderMergeTarget[]
  earnWithdrawals EarnWithdrawal[] @relation("EarnWithdrawalPaypal")
  createdById     String?      // user who created this PP
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([code, projectId])
  @@index([projectId, status])
  @@index([projectId, role])
}

// Holder → Mail gộp assignment (which PP is the merge target for a holder)
model HolderMergeTarget {
  id        String       @id @default(cuid())
  holder    String       // User Win (pp01, pp02...)
  paypal    PayPalAccount @relation(fields: [paypalId], references: [id], onDelete: Cascade)
  paypalId  String
  project   Project      @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([holder, projectId])
  @@index([projectId])
}

model PayPalEmail {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  archivedAt DateTime?
  id            String        @id @default(cuid())
  email         String
  password      String?       // encrypted
  twoFa         String?       // encrypted
  hotmailToken  String?       // encrypted
  isPrimary     Boolean       @default(false)
  notes         String?
  paypal        PayPalAccount @relation(fields: [paypalId], references: [id], onDelete: Cascade)
  paypalId      String
  project       Project       @relation(fields: [projectId], references: [id])
  projectId     String
  funds         FundTransaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([email, projectId])
  @@index([paypalId])
}

enum PayPalStatus {
  ACTIVE
  LIMITED
  SUSPENDED
  CLOSED
  PENDING_VERIFY
}

enum PayPalRole {
  NORMAL
  MASTER
  USDT
}

// ═══════════════════════════════════════
// FINANCIAL TRANSACTIONS
// ═══════════════════════════════════════

model FundTransaction {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  voidedAt DateTime?
  currency String @default("USD")
  id            String        @id @default(cuid())
  date          DateTime
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String
  confirmed     Boolean       @default(false)
  failed        Boolean       @default(false)  // Không về
  company       String        @default("Bright Data Ltd.")
  notes         String?
  paypal        PayPalAccount @relation(fields: [paypalId], references: [id], onDelete: Cascade)
  paypalId      String
  paypalEmail   PayPalEmail?  @relation(fields: [paypalEmailId], references: [id], onDelete: SetNull)
  paypalEmailId String?
  server        Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverId      String?
  vm            VirtualMachine? @relation(fields: [vmId], references: [id])
  vmId          String?
  project       Project       @relation(fields: [projectId], references: [id])
  projectId     String
  createdById   String?       // user who created this fund
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([transactionId, projectId])
  @@index([projectId, date])
  @@index([paypalId])
  @@index([paypalEmailId])
  @@index([confirmed])
  @@index([serverId])
  @@index([vmId])
}

model Withdrawal {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  voidedAt DateTime?
  currency String @default("USD")
  id             String          @id @default(cuid())
  date           DateTime
  amount         Decimal         @db.Decimal(12, 2)
  paypalFee      Decimal?        @db.Decimal(12, 2)
  paypalFeeSetAt DateTime?       // timestamp when paypalFee was first set — used for 24h edit lock
  collectorNote  String?
  paidToTeam     Boolean         @default(false)
  paidAt         DateTime?
  expense        CollectorExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId      String?
  transactionId  String?
  type           WithdrawalType
  agent          String?
  withdrawCode   String?
  ppReceived     String?
  mailConfirmed  Boolean         @default(false)
  notes          String?
  sourcePaypal   PayPalAccount   @relation("WithdrawalSource", fields: [sourcePaypalId], references: [id], onDelete: Cascade)
  sourcePaypalId String
  destPaypal     PayPalAccount?  @relation("WithdrawalDest", fields: [destPaypalId], references: [id], onDelete: SetNull)
  destPaypalId   String?
  agentUser      User?           @relation("AgentWithdrawals", fields: [agentUserId], references: [id])
  agentUserId    String?
  agentEmail     AgentPaypalEmail? @relation("AgentWithdrawalEmail", fields: [agentEmailId], references: [id])
  agentEmailId   String?
  agentConfirmed   Boolean         @default(false)
  agentDisputed    Boolean         @default(false)
  disputeNote      String?
  disputeResolved  Boolean         @default(false)
  disputeAction    String?         // "OVERRIDE" | "VOID" | "RESEND"
  adminResolveNote String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?           @relation("DisputeResolver", fields: [resolvedById], references: [id])
  project          Project         @relation(fields: [projectId], references: [id])
  projectId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId, date])
  @@index([projectId, type])
  @@index([sourcePaypalId])
  @@index([agentUserId])
}

enum WithdrawalType {
  MIXING
  EXCHANGE
}

model CostRecord {
  usdtRate Decimal? @db.Decimal(24,12)
  usdtAmount Decimal? @db.Decimal(24,6)
  fxAppliedAt DateTime?
  fxSource String?
  fxNote String?
  profitTreatment String @default("CASH_COST")
  sourceReceiptId String?
  sourceReceipt TeamReceipt? @relation(fields:[sourceReceiptId],references:[id],onDelete:Restrict)
  sourceCollectorExpenseId String? @unique
  sourceCollectorExpense CollectorExpense? @relation(fields:[sourceCollectorExpenseId],references:[id],onDelete:Restrict)
  businessManaged Boolean @default(false)
  revision Int @default(0)
  voidedAt DateTime?
  currency String @default("USD")
  serverId String?
  server Server? @relation(fields:[serverId],references:[id],onDelete:Restrict)
  proxyAccountId String?
  proxyAccount ProxyProviderAccount? @relation(fields:[proxyAccountId],references:[id],onDelete:Restrict)
  id            String    @id @default(cuid())
  code          String?
  date          DateTime
  category      String    @default("OTHER")
  amount        Decimal   @default(0) @db.Decimal(24, 8)
  serverCost    Decimal?  @db.Decimal(12, 2)
  ipCost        Decimal?  @db.Decimal(12, 2)
  extraCost     Decimal?  @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(24, 8)
  isPrepaid     Boolean   @default(false)
  note          String?
  fundingSource String?
  project       Project   @relation(fields: [projectId], references: [id])
  projectId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, date])
}

// ═══════════════════════════════════════
// PROFIT SPLIT
// ═══════════════════════════════════════

model Partner {
  id            String      @id @default(cuid())
  name          String
  percentage    Decimal     @db.Decimal(5, 2)
  note          String?
  active        Boolean     @default(true)
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([name, projectId])
  @@index([projectId])
}

model ProfitSplit {
  businessManaged Boolean @default(false)
  revision Int @default(0)
  voidedAt DateTime?
  currency String @default("USD")
  basis String @default("WITHDRAWN")
  sourceHash String?
  sourceSnapshotCipher String?
  id              String            @id @default(cuid())
  periodStart     DateTime
  periodEnd       DateTime
  totalWithdrawal Decimal           @db.Decimal(26, 6)
  totalCost       Decimal           @db.Decimal(26, 6)
  netProfit       Decimal           @db.Decimal(26, 6)
  usdtRate        Decimal?          @db.Decimal(10, 4)
  netProfitUsdt   Decimal?          @db.Decimal(26, 6)
  settled         Boolean           @default(false)
  notes           String?
  project         Project           @relation(fields: [projectId], references: [id])
  projectId       String
  allocations     SplitAllocation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SplitAllocation {
  revision Int @default(0)
  id            String      @id @default(cuid())
  partnerName   String
  percentage    Decimal     @db.Decimal(5, 2)
  amount        Decimal     @db.Decimal(26, 6)
  amountUsdt    Decimal?    @db.Decimal(26, 6)
  note          String?
  paid          Boolean     @default(false)
  split         ProfitSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  splitId       String
  createdAt     DateTime    @default(now())
}

// ═══════════════════════════════════════
// VM SCHEDULED TASKS
// ═══════════════════════════════════════

model VMTask {
  id            String       @id @default(cuid())
  vm            VirtualMachine @relation(fields: [vmId], references: [id], onDelete: Cascade)
  vmId          String
  configurationId String? @unique
  configuration VMConfiguration? @relation(fields:[configurationId],references:[id],onDelete:Restrict)
  type          String
  title         String
  description   String?
  scheduledAt   DateTime
  completedAt   DateTime?
  status        VMTaskStatus @default(PENDING)
  assignedTo    User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum VMProxySlotState {
  BLANK
  FORMULA
  PLACEHOLDER
  UNRESOLVED
  FULL
}
enum VMConfigurationStatus {
  PLANNED
  IN_PROGRESS
  FAILED
  CONFIRMED
  CANCELLED
}
enum VMAllocationRole {
  DESIRED
  INSTALLED
  UNCERTAIN
}
model VMSdkHistory {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  vmId String
  vm VirtualMachine @relation(fields:[vmId],references:[id],onDelete:Restrict)
  previousSdk String?
  newSdk String?
  actorId String
  note String?
  recordedAt DateTime @default(now())
  @@index([vmId,recordedAt])
  @@index([projectId,recordedAt])
}
model VMConfiguration {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  vmId String
  vm VirtualMachine @relation("VMVersions",fields:[vmId],references:[id],onDelete:Restrict)
  desiredBy VirtualMachine? @relation("DesiredVMConfiguration")
  installedBy VirtualMachine? @relation("InstalledVMConfiguration")
  version Int
  endpointId String?
  endpoint ProxyIP? @relation(fields:[endpointId],references:[id],onDelete:Restrict)
  snapshotCipher String
  configurationHash String
  status VMConfigurationStatus @default(PLANNED)
  createdById String
  createdAt DateTime @default(now())
  startedAt DateTime?
  confirmedAt DateTime?
  confirmedById String?
  failureNote String?
  revision Int @default(1)
  task VMTask?
  allocations VMProxyAllocation[]
  @@unique([vmId,version])
  @@index([projectId,status])
}
model VMProxyAllocation {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  vmId String
  vm VirtualMachine @relation(fields:[vmId],references:[id],onDelete:Restrict)
  endpointId String
  endpoint ProxyIP @relation(fields:[endpointId],references:[id],onDelete:Restrict)
  configurationId String
  configuration VMConfiguration @relation(fields:[configurationId],references:[id],onDelete:Restrict)
  allocationKey String
  role VMAllocationRole @default(DESIRED)
  createdById String
  createdAt DateTime @default(now())
  releasedAt DateTime?
  releaseReason String?
  revision Int @default(1)
  @@index([projectId,vmId])
  @@index([endpointId])
}

enum VMTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ═══════════════════════════════════════
// DELETE REQUESTS
// ═══════════════════════════════════════

model DeleteRequest {
  id              String              @id @default(cuid())
  entity          String
  entityId        String
  entityLabel     String?
  reason          String?
  status          DeleteRequestStatus @default(PENDING)
  requestedBy     User                @relation("DeleteRequestor", fields: [requestedById], references: [id])
  requestedById   String
  reviewedBy      User?               @relation("DeleteReviewer", fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewNote      String?
  project         Project             @relation(fields: [projectId], references: [id])
  projectId       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId, status])
  @@index([entity, entityId])
}

enum DeleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entity      String
  entityId    String
  changes     Json?
  projectId   String?
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@index([projectId])
}

// ═══════════════════════════════════════
// AGENT PAYPAL
// ═══════════════════════════════════════

model AgentPaypalEmail {
  id          String       @id @default(cuid())
  email       String
  label       String?
  user        User         @relation("AgentEmails", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project      @relation(fields: [projectId], references: [id])
  projectId   String
  withdrawals Withdrawal[] @relation("AgentWithdrawalEmail")
  sales       AgentSale[]  @relation("AgentSaleEmail")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([email, projectId])
  @@index([userId])
  @@index([projectId])
}

model AgentSale {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(12, 2)  // gross amount
  feePercent    Decimal?         @db.Decimal(5, 2)   // agent fee % (default 3%)
  paypalFee     Decimal?         @db.Decimal(12, 2)  // PayPal transfer fee (agent notes)
  netAmount     Decimal?         @db.Decimal(12, 2)  // net = amount - paypalFee - (amount * feePercent/100)
  agentEarning  Decimal?         @db.Decimal(12, 2)  // tiền agent nhận = (amount - paypalFee) * feePercent/100
  withdrawn     Boolean          @default(false)     // agent đã rút tiền chưa
  withdrawnAt   DateTime?                            // ngày rút
  transactionId String
  exchangeEmail String?
  notes         String?
  agentUser     User             @relation("AgentSales", fields: [agentUserId], references: [id])
  agentUserId   String
  agentEmail    AgentPaypalEmail @relation("AgentSaleEmail", fields: [agentEmailId], references: [id])
  agentEmailId  String
  project       Project          @relation(fields: [projectId], references: [id])
  projectId     String
  date          DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([agentUserId])
  @@index([agentEmailId])
  @@index([projectId])
}

// ═══════════════════════════════════════
// COLLECTOR EXPENSES (wallet outflow)
// ═══════════════════════════════════════

model CollectorExpense {
  revision Int @default(0)
  businessManaged Boolean @default(false)
  voidedAt DateTime?
  teamReceipt TeamReceipt?
  sourcedCost CostRecord?
  id             String       @id @default(cuid())
  date           DateTime     @default(now())
  type           String       // "TEAM_PAYMENT" | "BILL" | "OTHER"
  amount         Decimal      @db.Decimal(12, 2)
  referenceId    String       // Bank TX ID, invoice number, or any audit reference
  note           String?
  collector      User         @relation("CollectorExpenses", fields: [collectorId], references: [id])
  collectorId    String
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  withdrawals    Withdrawal[] // linked withdrawals (optional, 0..N)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([collectorId, date])
  @@index([projectId])
}

model TeamReceipt {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  receivedAt DateTime
  amountUsdt Decimal? @db.Decimal(24,6)
  referenceId String?
  referenceKey String? @unique
  status String @default("DRAFT")
  collectorId String?
  collector User? @relation("TeamReceiptCollector",fields:[collectorId],references:[id],onDelete:Restrict)
  sourceCollectorExpenseId String? @unique
  sourceCollectorExpense CollectorExpense? @relation(fields:[sourceCollectorExpenseId],references:[id],onDelete:Restrict)
  collectorUsdAmount Decimal? @db.Decimal(24,8)
  createdById String
  createdBy User @relation("TeamReceiptCreator",fields:[createdById],references:[id],onDelete:Restrict)
  notes String?
  revision Int @default(0)
  voidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nettedCosts CostRecord[]
  @@index([projectId,receivedAt])
}

// ═══════════════════════════════════════
// EDIT HISTORY (30-day undo)
// ═══════════════════════════════════════

model EditHistory {
  id          String   @id @default(cuid())
  entity      String   // "PayPalAccount", "FundTransaction", "PayPalEmail", etc.
  entityId    String   // ID of the record edited
  field       String   // field name that was changed
  oldValue    String?  // previous value (as string)
  newValue    String?  // new value (as string)
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  reverted    Boolean  @default(false)
  revertedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([entityId, entity])
  @@index([projectId, createdAt])
  @@index([userId])
}

// ═══════════════════════════════════════
// AUTOTYPE SESSIONS
// ═══════════════════════════════════════

model AutotypeSession {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String   // unique device identifier from AutoType tool
  deviceName  String?  // optional label (e.g. "PC Van phong 1")
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([lastActiveAt])
}

model BusinessWorkItem {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  title String
  notes String?
  status VMTaskStatus @default(PENDING)
  serverId String?
  server Server? @relation(fields:[serverId],references:[id],onDelete:Restrict)
  vmId String?
  vm VirtualMachine? @relation(fields:[vmId],references:[id],onDelete:Restrict)
  assigneeId String?
  assignee User? @relation("BusinessAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  createdById String
  completedById String?
  completedAt DateTime?
  dueDate DateTime?
  archivedAt DateTime?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId,status])
}
